{
  "name": "raycart",
  "version": "0.0.1",
  "description": "Wasm host exposing the full raylib API — compile games with wasi-sdk, run on native or web without recompile",
  "type": "module",
  "exports": "./host/web/index.js",
  "files": [
    "web/index.js",
    "web/emfs.js",
    "web/raylib_em.mjs"
  ],
  "scripts": {
    "gen:cart_c": "node scripts/gen_cart_c_header.js",
    "build:host_web": "node scripts/build_host_web.js",
    "build:carts": "node scripts/build_cart.js src/carts/*",
    "prebuild:carts": "npm run gen:cart_c",
    "start": "npx -y live-server web --port=3000",
    "prestart": "npm run build:host_web && npm run build:carts",
    "test": "node --test",
    "fmt": "npx -y prettier -w ."
  },
  "dependencies": {
    "@easywasm/wasi": "^0.0.8",
    "fflate": "^0.8.2"
  }
}
