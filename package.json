{
  "name": "raycart",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npx -y npm-run-all --parallel build:native build:web",
    "build:native": "cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build",
    "build:web": "emcmake cmake -B wbuild -DCMAKE_BUILD_TYPE=Release -DPLATFORM=Web && cmake --build wbuild",
    "build:carts": "cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --target=carts",
    "codegen": "npx -y npm-run-all --parallel codegen:*",
    "codegen:host": "node codegen/generate_host_web.js",
    "codegen:cart": "node codegen/generate_cart_c.js",
    "codegen:cartjs": "node codegen/generate_cart_js.js",
    "start": "npx -y live-server demo",
    "prestart": "npx -y npm-run-all --parallel build:web build:carts",
    "clean": "rm -rf build wbuild demo/*.mjs demo/*.zip"
  }
}
