{
  "name": "raycart",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npx -y npm-run-all --parallel build:nativefull build:web",
    "build:nativefull": "cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_CARTS=ON -DBUILD_HOST=ON && cmake --build build",
    "build:native": "cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_CARTS=OFF -DBUILD_HOST=ON && cmake --build build",
    "build:web": "emcmake cmake -B wbuild -DCMAKE_BUILD_TYPE=Release -DPLATFORM=Web -DBUILD_CARTS=OFF -DBUILD_HOST=ON && cmake --build wbuild",
    "build:carts": "cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_CARTS=ON -DBUILD_HOST=OFF && cmake --build build --target=carts",
    "codegen": "npx -y npm-run-all --parallel codegen:*",
    "codegen:hostweb": "node codegen/generate_host_web.js",
    "codegen:hostnative": "node codegen/generate_host_native.js",
    "codegen:cart": "node codegen/generate_cart_c.js",
    "codegen:cartjs": "node codegen/generate_cart_js.js",
    "start": "npx -y live-server demo",
    "prestart": "npx -y npm-run-all --parallel build:web build:carts",
    "clean": "npx -y rimraf build wbuild demo/*.mjs demo/carts/*",
    "format": "npx -y prettier -w ."
  }
}
